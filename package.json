{
  "name": "javabytecodeviewer",
  "displayName": "JavaBytecodeViewer",
  "description": "Allows viewing the bytcode of a class in a referenced library in editor.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "extensionDependencies": [
    "redhat.java",
    "vscjava.vscode-java-dependency"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "javabytecodeviewer.viewbytecode",
        "title": "View Bytecode"
      }
    ],
    "menus": {
      "view/item/context":[
        {
          "command": "javabytecodeviewer.viewbytecode",
          "when": "view == javaProjectExplorer && viewItem == java:type+class"
        }
      ],
      "editor/title/context": [
        {
          "command": "javabytecodeviewer.viewbytecode",
          "when": "resourceExtname == .java && resourceScheme == jdt",
          "group": "2_files@200"
        }
      ]
    }
    
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.134.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
